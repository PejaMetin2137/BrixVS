# Skopiuj ten plik jako .env i wpisz swoje klucze:
#   cp .env.example .env
# Plik .env jest w .gitignore, wiec nie trafi na GitHuba.

# Baza danych (domyslnie PostgreSQL z docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://admin:secretpassword@localhost:5432/lego_db

# BrickLink API - klucze z: BrickLink -> My BrickLink -> Settings -> API Access
BL_CONSUMER_KEY=
BL_CONSUMER_SECRET=
BL_TOKEN_VALUE=
BL_TOKEN_SECRET=
BL_CURRENCY=PLN
BL_REGION=europe

# Rebrickable API - klucz z: rebrickable.com -> Account -> Settings -> API
REBRICKABLE_API_KEY=
